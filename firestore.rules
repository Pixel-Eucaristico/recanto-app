rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // Helper Functions
    // ===========================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário é admin (usado para config de sistema)
    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Verifica se o usuário tem uma feature específica
    // Verifica: 1) Se é admin, 2) Se tem a feature individual, 3) Se o grupo/role dele tem a feature
    function hasFeature(feature) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let userRole = userDoc.get('role', '');
      let userFeatures = userDoc.get('features', []);

      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               // Admin sempre tem acesso total
               userRole == 'admin' ||
               // Verifica features individuais do usuário
               (userFeatures.hasAny([feature, '*'])) ||
               // Verifica features do grupo/role do usuário no permissions_config
               (userRole != '' &&
                exists(/databases/$(database)/documents/permissions_config/$(userRole)) &&
                get(/databases/$(database)/documents/permissions_config/$(userRole)).data.get('features', []).hasAny([feature, '*']))
             );
    }

    // ===========================
    // Users Collection
    // ===========================
    match /users/{userId} {
      // Leitura: usuários autenticados podem ler
      allow read: if isAuthenticated();

      // Escrita: próprio usuário ou quem tem manage:users
      allow create: if isAuthenticated();
      allow update: if request.auth.uid == userId || hasFeature('manage:users');
      allow delete: if hasFeature('manage:users');

      // Campo 'role' e 'features' só podem ser alterados por quem tem manage:users
      allow update: if hasFeature('manage:users') ||
                      (request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'features']));
    }

    // ===========================
    // Permissions Config Collection
    // ===========================
    match /permissions_config/{roleId} {
      // Leitura: pública para resolver permissões dinâmicas (mesmo antes do login)
      allow read: if true;
      // Escrita: admin sempre pode, ou quem tem manage:roles
      allow write: if isAdmin() || hasFeature('manage:roles');
    }

    // ===========================
    // Materials Collection
    // ===========================
    match /materials/{materialId} {
      // Leitura: quem tem read:content ou manage:materials
      allow read: if hasFeature('read:content') || hasFeature('manage:materials');

      // Criação: quem tem create:content ou manage:materials
      allow create: if (hasFeature('create:content') || hasFeature('manage:materials')) &&
                      request.resource.data.keys().hasAll([
                        'title', 'type', 'category', 'target_audience', 'created_by', 'created_at'
                      ]);

      // Atualização: quem tem update:content ou manage:materials
      allow update: if (hasFeature('update:content') || hasFeature('manage:materials')) &&
                      request.resource.data.keys().hasAll([
                        'id', 'title', 'type', 'category', 'target_audience', 'created_by', 'created_at'
                      ]);

      // Deleção: quem tem delete:content ou manage:materials
      allow delete: if hasFeature('delete:content') || hasFeature('manage:materials');
    }

    // ===========================
    // Donations Collection
    // ===========================
    match /donations/{donationId} {
      // Leitura: quem tem manage:donations ou próprio doador
      allow read: if hasFeature('manage:donations') ||
                    (isAuthenticated() && resource.data.donor_id == request.auth.uid);

      // Criação: usuários autenticados (qualquer um pode doar)
      allow create: if isAuthenticated() &&
                      request.resource.data.keys().hasAll([
                        'value', 'method', 'date', 'status', 'created_at'
                      ]);

      // Atualização: quem tem manage:donations
      allow update: if hasFeature('manage:donations') &&
                      request.resource.data.keys().hasAll([
                        'id', 'value', 'method', 'date', 'status', 'created_at'
                      ]);

      // Deleção: quem tem manage:donations
      allow delete: if hasFeature('manage:donations');
    }

    // ===========================
    // Forum Topics Collection
    // ===========================
    match /forum_topics/{topicId} {
      // Leitura: quem tem read:forum
      allow read: if hasFeature('read:forum');

      // Criação: quem tem create:forum_topic
      allow create: if hasFeature('create:forum_topic') &&
                      request.resource.data.keys().hasAll([
                        'title', 'created_by', 'created_at'
                      ]);

      // Atualização: admin ou criador do tópico
      allow update: if (isAdmin() || (isAuthenticated() && resource.data.created_by == request.auth.uid)) &&
                      request.resource.data.keys().hasAll([
                        'id', 'title', 'created_by', 'created_at'
                      ]);

      // Deleção: admin ou criador do tópico
      allow delete: if isAdmin() ||
                      (isAuthenticated() && resource.data.created_by == request.auth.uid);
    }

    // ===========================
    // Forum Posts Collection
    // ===========================
    match /forum_posts/{postId} {
      // Leitura: quem tem read:forum
      allow read: if hasFeature('read:forum');

      // Criação: quem tem create:forum_post
      allow create: if hasFeature('create:forum_post') &&
                      request.resource.data.keys().hasAll([
                        'topic_id', 'content', 'created_by', 'is_approved', 'created_at'
                      ]);

      // Atualização: admin (para aprovar) ou criador do post
      allow update: if (isAdmin() || (isAuthenticated() && resource.data.created_by == request.auth.uid)) &&
                      request.resource.data.keys().hasAll([
                        'id', 'topic_id', 'content', 'created_by', 'is_approved', 'created_at'
                      ]);

      // Deleção: admin ou criador
      allow delete: if isAdmin() ||
                      (isAuthenticated() && resource.data.created_by == request.auth.uid);
    }

    // ===========================
    // Events Collection
    // ===========================
    match /events/{eventId} {
      // Leitura: quem tem read:calendar ou read:public_calendar (para eventos públicos)
      allow read: if hasFeature('read:calendar') ||
                    (resource.data.is_public == true && hasFeature('read:public_calendar')) ||
                    (resource.data.is_public == true);

      // Criação: quem tem manage:calendar
      allow create: if hasFeature('manage:calendar');

      // Atualização: quem tem manage:calendar
      allow update: if hasFeature('manage:calendar');

      // Deleção: quem tem manage:calendar
      allow delete: if hasFeature('manage:calendar');
    }

    // ===========================
    // Acompanhamentos Collection
    // ===========================
    match /acompanhamentos/{acompanhamentoId} {
      // Leitura: quem tem manage:followup, pai (read:parent_zone) ou o próprio recantiano
      allow read: if hasFeature('manage:followup') ||
                    hasFeature('read:parent_zone') ||
                    (isAuthenticated() && resource.data.recantiano_id == request.auth.uid);

      // Criação: quem tem manage:followup
      allow create: if hasFeature('manage:followup') &&
                      request.resource.data.keys().hasAll([
                        'recantiano_id', 'missionario_id', 'date', 'tipo', 'created_at'
                      ]);

      // Atualização: quem tem manage:followup
      allow update: if hasFeature('manage:followup') &&
                      request.resource.data.keys().hasAll([
                        'id', 'recantiano_id', 'missionario_id', 'date', 'tipo', 'created_at'
                      ]);

      // Deleção: quem tem manage:followup
      allow delete: if hasFeature('manage:followup');
    }

    // ===========================
    // Desafios Collection
    // ===========================
    match /desafios/{desafioId} {
      // Leitura: usuários autenticados
      allow read: if isAuthenticated();

      // Criação: quem tem manage:challenges
      allow create: if hasFeature('manage:challenges') &&
                      request.resource.data.keys().hasAll([
                        'title', 'description', 'category', 'difficulty', 'created_at'
                      ]);

      // Atualização: quem tem manage:challenges
      allow update: if hasFeature('manage:challenges') &&
                      request.resource.data.keys().hasAll([
                        'id', 'title', 'description', 'category', 'difficulty', 'created_at'
                      ]);

      // Deleção: quem tem manage:challenges
      allow delete: if hasFeature('manage:challenges');
    }

    // ===========================
    // Desafio Registros Collection
    // ===========================
    match /desafio_registros/{registroId} {
      // Leitura: quem tem manage:challenges ou o próprio recantiano
      allow read: if hasFeature('manage:challenges') ||
                    (isAuthenticated() && resource.data.recantiano_id == request.auth.uid);

      // Criação: usuários autenticados
      allow create: if isAuthenticated() &&
                      request.resource.data.keys().hasAll([
                        'desafio_id', 'recantiano_id', 'completed', 'created_at'
                      ]);

      // Atualização: quem tem manage:challenges ou o próprio recantiano
      allow update: if (hasFeature('manage:challenges') ||
                      (isAuthenticated() && resource.data.recantiano_id == request.auth.uid)) &&
                      request.resource.data.keys().hasAll([
                        'id', 'desafio_id', 'recantiano_id', 'completed', 'created_at'
                      ]);

      // Deleção: quem tem manage:challenges
      allow delete: if hasFeature('manage:challenges');
    }

    // ===========================
    // Google Calendar Configs Collection
    // ===========================
    match /google_calendar_configs/{userId} {
      // Leitura: próprio usuário que tem manage:calendar
      allow read: if isAuthenticated() && request.auth.uid == userId && hasFeature('manage:calendar');

      // Escrita: próprio usuário que tem manage:calendar
      allow write: if isAuthenticated() && request.auth.uid == userId && hasFeature('manage:calendar');
    }

    // ===========================
    // Content Pages Collection (CMS)
    // ===========================
    match /content_pages/{pageId} {
      // Leitura: SEMPRE permitir queries, mas filtrar por is_published
      // Permite que visitantes não autenticados busquem páginas publicadas
      allow read: if true;

      // Criação: quem tem manage:cms
      allow create: if hasFeature('manage:cms');

      // Atualização: quem tem manage:cms
      allow update: if hasFeature('manage:cms');

      // Deleção: quem tem manage:cms
      allow delete: if hasFeature('manage:cms');
    }

    // ===========================
    // Menu Config Collection (CMS)
    // ===========================
    match /menu_config/{menuId} {
      // Leitura: público (para que o Navbar possa buscar)
      // O filtro por is_published é feito no código
      allow read: if true;

      // Criação: quem tem manage:menu
      allow create: if hasFeature('manage:menu');

      // Atualização: quem tem manage:menu
      allow update: if hasFeature('manage:menu');

      // Deleção: quem tem manage:menu
      allow delete: if hasFeature('manage:menu');
    }

    // ===========================
    // Mods Configs Collection (CMS)
    // ===========================
    match /mods_configs/{configId} {
      // Leitura: pública (para carregar definições de blocos)
      allow read: if true;
      // Escrita: quem tem manage:cms
      allow write: if hasFeature('manage:cms');
    }

    // ===========================
    // Form Submissions Collection
    // ===========================
    match /form_submissions/{submissionId} {
      // Criação: qualquer visitante (para enviar contato/feedback)
      allow create: if true;
      // Leitura/Update/Delete: quem tem read:submissions
      allow read, update, delete: if hasFeature('read:submissions');
    }

    // ===========================
    // Global Configs
    // ===========================
    match /config/{docId} {
      // Configurações gerais do sistema
      // Apenas admins podem ler e escrever (isso precisa ser isAdmin direto pois é config de sistema)
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ===========================
    // Formation Track Types Collection
    // ===========================
    match /formation_track_types/{typeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Formation Tracks Collection
    // ===========================
    match /formation_tracks/{trackId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Formation Modules Collection
    // ===========================
    match /formation_modules/{moduleId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Formation Lessons Collection
    // ===========================
    match /formation_lessons/{lessonId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Formation Progress Collection
    // ===========================
    match /formation_progress/{progressId} {
      // Leitura: próprio progresso ou quem tem review:formation
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      // Criação/atualização: próprio usuário
      allow create: if isAuthenticated() &&
                      request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() &&
                      resource.data.user_id == request.auth.uid;
      // Deleção: só admin
      allow delete: if isAdmin();
    }

    // ===========================
    // Quizzes Collection
    // ===========================
    match /quizzes/{quizId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Quiz Attempts Collection
    // ===========================
    match /quiz_attempts/{attemptId} {
      // Leitura: próprio usuário OU quem tem review:formation
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      // Criação: próprio usuário com complete:formation
      allow create: if isAuthenticated() &&
                      hasFeature('complete:formation') &&
                      request.resource.data.user_id == request.auth.uid;
      // Tentativas são imutáveis (audit trail)
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===========================
    // Crosswords Collection
    // ===========================
    match /crosswords/{puzzleId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Crossword Results Collection
    // ===========================
    match /crossword_results/{resultId} {
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() &&
                      hasFeature('complete:formation') &&
                      request.resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===========================
    // Word Searches Collection
    // ===========================
    match /word_searches/{puzzleId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Word Search Results Collection
    // ===========================
    match /word_search_results/{resultId} {
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() &&
                      hasFeature('complete:formation') &&
                      request.resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===========================
    // Mind Map Templates Collection
    // ===========================
    match /mind_map_templates/{templateId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Student Mind Maps Collection (snapshot por aluno)
    // ===========================
    match /student_mind_maps/{mapId} {
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() &&
                      hasFeature('complete:formation') &&
                      request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ===========================
    // Media Registry Collection (dedupe de arquivos R2)
    // ===========================
    match /media_registry/{assetId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploaded_by == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===========================
    // Case Studies Collection
    // ===========================
    match /case_studies/{caseId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Case Runs Collection
    // ===========================
    match /case_runs/{runId} {
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() &&
                      hasFeature('complete:formation') &&
                      request.resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===========================
    // Flashcard Decks Collection
    // ===========================
    match /flashcard_decks/{deckId} {
      allow read: if hasFeature('read:formation') || hasFeature('manage:formation');
      allow create: if hasFeature('manage:formation');
      allow update: if hasFeature('manage:formation');
      allow delete: if hasFeature('manage:formation');
    }

    // ===========================
    // Flashcard Reviews Collection
    // ===========================
    match /flashcard_reviews/{reviewId} {
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() &&
                      hasFeature('complete:formation') &&
                      request.resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===========================
    // Video Watch Sessions (log append-only de visualizações)
    // ===========================
    match /video_watch_sessions/{sessionId} {
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() &&
                      request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ===========================
    // Habits (admin CRUD, todos leem)
    // ===========================
    match /habits/{habitId} {
      allow read: if hasFeature('log:habits') || hasFeature('manage:habits');
      allow write: if hasFeature('manage:habits') || isAdmin();
    }

    // ===========================
    // Habit Logs (id determinístico {habitId}_{userId}_{YYYY-MM-DD})
    // ===========================
    match /habit_logs/{logId} {
      allow read: if hasFeature('manage:habits') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow write: if isAuthenticated() &&
                     hasFeature('log:habits') &&
                     request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // ===========================
    // Community Categories (admin gerencia)
    // ===========================
    match /community_categories/{categoryId} {
      allow read: if hasFeature('read:community') || hasFeature('manage:community');
      allow write: if hasFeature('manage:community') || isAdmin();
    }

    // ===========================
    // Community Posts (fórum / enquete / mural)
    // ===========================
    match /community_posts/{postId} {
      allow read: if hasFeature('read:community') || hasFeature('manage:community');
      allow create: if isAuthenticated() &&
                      hasFeature('post:community') &&
                      request.resource.data.created_by == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.created_by == request.auth.uid) ||
                      hasFeature('manage:community');
      allow delete: if (isAuthenticated() && resource.data.created_by == request.auth.uid) ||
                      hasFeature('manage:community');
    }

    // ===========================
    // Community Replies
    // ===========================
    match /community_replies/{replyId} {
      allow read: if hasFeature('read:community') || hasFeature('manage:community');
      allow create: if isAuthenticated() &&
                      hasFeature('post:community') &&
                      request.resource.data.created_by == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.created_by == request.auth.uid;
      allow delete: if (isAuthenticated() && resource.data.created_by == request.auth.uid) ||
                      hasFeature('manage:community');
    }

    // ===========================
    // Poll Votes (id determinístico {pollId}_{userId})
    // ===========================
    match /community_poll_votes/{voteId} {
      allow read: if hasFeature('read:community') || hasFeature('manage:community');
      // Dono pode criar/atualizar — troca o voto via setDoc merge
      allow write: if isAuthenticated() &&
                     hasFeature('post:community') &&
                     request.resource.data.user_id == request.auth.uid &&
                     voteId == (request.resource.data.poll_id + '_' + request.auth.uid);
      allow delete: if isAdmin();
    }

    // ===========================
    // Library — Books / Chapters / Categories
    // ===========================
    match /library_books/{bookId} {
      allow read: if hasFeature('read:library') || hasFeature('manage:library');
      allow create: if hasFeature('manage:library') || isAdmin();
      allow update, delete: if hasFeature('manage:library') || isAdmin();
    }

    match /library_book_chapters/{chapterId} {
      allow read: if hasFeature('read:library') || hasFeature('manage:library');
      allow write: if hasFeature('manage:library') || isAdmin();
    }

    match /library_book_categories/{catId} {
      allow read: if hasFeature('read:library') || hasFeature('manage:library');
      allow write: if hasFeature('manage:library') || isAdmin();
    }

    match /book_reading_progress/{progressId} {
      // Leitura: dono, admin ou quem tem review:formation (formadores/missionários acompanhando alunos).
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin() ||
        hasFeature('review:formation')
      );
      allow create, update: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        hasFeature('read:library');
    }

    match /book_highlights/{highlightId} {
      allow read, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create, update: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        hasFeature('read:library');
    }

    match /book_comments/{commentId} {
      allow read, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create, update: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        hasFeature('read:library');
    }

    match /book_tags/{tagId} {
      allow read, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create, update: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        hasFeature('read:library');
    }

    // ===========================
    // Spiritual Reflections Collection (Caderno Espiritual)
    // ===========================
    match /spiritual_reflections/{reflectionId} {
      // Leitura: dono ou quem revisa (review:formation)
      allow read: if hasFeature('review:formation') ||
                    (isAuthenticated() && resource.data.user_id == request.auth.uid);
      // Criação: próprio usuário com complete:formation
      allow create: if isAuthenticated() &&
                      hasFeature('complete:formation') &&
                      request.resource.data.user_id == request.auth.uid;
      // Atualização: dono (editar rascunho / enviar) OU quem revisa (adicionar comentário)
      allow update: if (isAuthenticated() && resource.data.user_id == request.auth.uid) ||
                      hasFeature('review:formation');
      // Deleção: só admin
      allow delete: if isAdmin();
    }
  }
}
